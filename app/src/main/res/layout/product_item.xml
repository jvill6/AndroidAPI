<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="15dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

    <ImageView
        android:layout_height="30dp"
        android:layout_width="30dp"
        android:src="@drawable/arrow_back"
        android:scaleType="centerInside"
        android:scaleX="1.2"
        android:scaleY="1.2"/>

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:scaleX="1.1"
        android:scaleY="1.1"
        android:text="Stock Details"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        android:textColor="#023178"
        android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="383dp"
        android:layout_height="31dp"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stock ID: "
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 "
            android:textSize="16sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/txtPrice"
            android:layout_width="147dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:text="Adult Stage"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="KOI GROUP"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtSku"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="italic"
        android:text="Cyprinus rubrofuscus"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtPrice"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginTop="10dp"
        android:text="Tank A1"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="383dp"
        android:layout_height="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stocked: "
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="March 12, 2027"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:text="Est. Harvest: "
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="March 12, 2028"
            android:textSize="14sp"/>
    </LinearLayout>


    <TextView
        android:id="@+id/txtPrice"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginTop="10dp"
        android:text="Population"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="383dp"
        android:layout_height="25dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtName"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:text="60"
            android:textColor="#023178"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="pcs"
            android:textSize="14sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/txtPrice"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginTop="30dp"
        android:text="Feeding Requirement"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="383dp"
        android:layout_height="25dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtName"
            android:layout_width="106dp"
            android:layout_height="wrap_content"
            android:text="Daily Feed:"
            android:textColor="#023178"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtName"
            android:layout_width="218dp"
            android:layout_height="wrap_content"
            android:text="100 grams"
            android:tetColor="#023178"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
    <TextView
        android:id="@+id/txtPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5"
        android:text="Recommended Feed Type: Pellets"
        android:textSize="14sp"/>

    <LinearLayout
        android:layout_width="383dp"
        android:layout_height="20dp"
        android:layout_marginTop="15dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="74dp"
            android:layout_height="wrap_content"
            android:text="3 Feedings"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="scheduled today"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:text="RAAGHH RECALCULATE "
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtPrice"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginTop="30dp"
        android:text="Today's Feeding Schedule"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="383dp"
        android:layout_height="20dp"
        android:layout_marginTop="15dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="74dp"
            android:layout_height="wrap_content"
            android:text="3 Feedings"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="scheduled today"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:text="RAAGHH DONED OR NAH"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>




</LinearLayout>