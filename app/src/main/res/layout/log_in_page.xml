<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/screen_background"
        android:padding="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="50dp">

            <ImageView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/profile_pic"
                android:layout_gravity="center"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="25dp"
                android:text="AquaFeeder"
                android:textColor="#023178"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSku"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginBottom="10dp"
                android:text="Precision aquatic management starts here."
                android:textSize="14dp" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/white_background"
                android:orientation="vertical"
                android:padding="25dp">

                <TextView
                    android:id="@+id/txtSku"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FIRST NAME"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp"
                    android:textSize="14dp" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Jane"
                    android:padding="10dp"
                    android:gravity="left|center"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="14dp"
                    android:layout_marginBottom="10dp"
                    android:textColor="@color/black"
                    android:background="@drawable/light_blue_background" />

                <TextView
                    android:id="@+id/txtSku"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LAST NAME"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="5dp"
                    android:textSize="14dp" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Doe"
                    android:padding="10dp"
                    android:gravity="left|center"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="14dp"
                    android:layout_marginBottom="10dp"
                    android:textColor="@color/black"
                    android:background="@drawable/light_blue_background" />

                <TextView
                    android:id="@+id/txtSku"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EMAIL ADDRESS"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="5dp"
                    android:textSize="14dp" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="Jane.doe@gmail.com"
                    android:padding="10dp"
                    android:drawableStart="@drawable/email_icon"
                    android:gravity="left|center"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="14dp"
                    android:layout_marginBottom="10dp"
                    android:textColor="@color/black"
                    android:background="@drawable/light_blue_background" />

                <TextView
                    android:id="@+id/txtSku"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PASSWORD"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="5dp"
                    android:textSize="14dp" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="Jane_Doe123"
                    android:padding="10dp"
                    android:gravity="left|center"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="14dp"
                    android:drawableStart="@drawable/password_icon"
                    android:drawableEnd="@drawable/see_pass_icon"
                    android:layout_marginBottom="10dp"
                    android:textColor="@color/black"
                    android:background="@drawable/light_blue_background" />

                <android.widget.Button
                    android:layout_width="match_parent"
                    android:gravity="center"
                    android:layout_height="50dp"
                    android:text="Create Account"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp"
                    android:textColor="@color/white"
                    android:background="@drawable/blue_background"/>



            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>